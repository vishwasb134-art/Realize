<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Assignment Reminder and Alarm Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Social Media Usage Stats Permission -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Overlay permission for instantaneous App Locker over games and social apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service Permission for Continuous Social App & Study Monitoring -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Geofencing Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Internet & Network Permissions (For OpenStreetMap & Gemini AI) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Query installed apps on device to pick social apps and detect games -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".RealizeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Realize">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock Screen Activity displayed during study hours to block Instagram & games -->
        <activity
            android:name=".ui.screens.schedule.LockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:theme="@style/Theme.Realize"
            android:windowSoftInputMode="adjustNothing" />

        <!-- BroadcastReceiver for device reboot: reschedules all reminder alarms & geofences -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for individual assignment alarms -->
        <receiver
            android:name=".receiver.AssignmentReminderReceiver"
            android:exported="false" />

        <!-- BroadcastReceiver for Social Limit Alert Snooze action -->
        <receiver
            android:name=".receiver.UsageAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.realize.app.ACTION_SNOOZE_10_MIN" />
            </intent-filter>
        </receiver>

        <!-- BroadcastReceiver for Geofence transitions (Entering shopping / avoid zones) -->
        <receiver
            android:name=".geofence.GeofenceBroadcastReceiver"
            android:exported="true" />

        <!-- Foreground Service for Social Usage Monitoring & Study Guard (Android 14+ specialUse) -->
        <service
            android:name=".service.UsageMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitoring student social media usage to alert about pending study assignments and enforce study schedule app locks" />
        </service>

    </application>

</manifest>
